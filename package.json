        "typescript": "^7.0.2",
        "vite": "^8.3.0",
        "wrangler": "^4.131.2"
    },
    "dependencies": {
        "alea": "^1.0.1",
        "mainloop.js": "^1.0.4",
        "planck": "^1.5.0",
        "poly-decomp": "^0.3.0"
    }
